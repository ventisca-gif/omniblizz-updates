.system-ui148 nav{display:flex;gap:6px;margin-bottom:18px}.system-ui148 nav button[aria-pressed=true]{border-color:#8ce2ff;background:#16496c}.status-top151{display:flex;align-items:center;justify-content:center;gap:40px;padding:12px;margin-bottom:16px}.status-top151>strong{font:64px Georgia,serif;color:#e7faff;text-shadow:0 0 14px #68d8ff}.status-top151 strong small{display:block;font:14px monospace;text-align:center;letter-spacing:2px}.status-top151 p{margin:8px 0}.status-bars151{border:1px solid #6f9eb3;display:flex;justify-content:space-around;gap:20px;padding:18px}.status-bars151>div{flex:1}.status-bars151 progress{width:75%;height:12px;accent-color:#b2ebff}.status-bars151 small{display:block;text-align:right}.status-stats151{margin:20px auto;border:1px solid #5f8ba3;padding:18px;display:grid;grid-template-columns:1fr 1fr;gap:18px 30px}.status-stats151 button{display:flex;align-items:center;gap:12px;background:none!important;border:0!important;font:22px Georgia,serif!important;min-height:58px}.status-stats151 svg{width:35px;height:35px;fill:none;stroke:#b7efff;filter:drop-shadow(0 0 5px #70cfff)}.status-stats151 strong{margin-left:auto;font-size:30px}.status-stats151 i{font-style:normal;color:#a8ffdc}.inventory151 button svg{width:48px;height:48px;stroke:#bfefff;fill:none}.inventory151 button{min-height:105px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:5px}.inventory151 button i{font-size:26px;font-style:normal;color:#224575}.equip-layout151{position:relative;min-height:410px;background:radial-gradient(ellipse at center,#193b5680,transparent 70%);margin:12px 0}.equip-lines151{position:absolute;width:100%;height:100%;inset:0;pointer-events:none}.equip-body151{position:absolute;left:40%;top:0;width:20%;height:100%}.equip-body151 svg{width:100%;height:100%;filter:drop-shadow(0 0 7px #73bfff55)}.equip-slot151{position:absolute;width:24%;height:100px;display:flex!important;align-items:center;flex-wrap:wrap;gap:5px;border:1px solid #b6d6e9!important;background:#18283bce!important;padding:7px!important}.equip-slot151 svg{width:40px;height:40px;stroke:#b9e7ff;fill:none}.equip-slot151 span{flex:1;min-width:65px;font-size:13px}.equip-slot151 small{width:100%;font-size:12px;color:#abf5a1}.equip-slot151.pos0{left:1%;top:10%}.equip-slot151.pos1{left:1%;top:39%}.equip-slot151.pos2{left:1%;top:70%}.equip-slot151.pos3{right:1%;top:0}.equip-slot151.pos4{right:1%;top:27%}.equip-slot151.pos5{right:1%;top:54%}.equip-slot151.pos6{right:1%;top:81%}.quest-goals151{margin:20px 10%;padding:15px;border-block:1px solid #4a738b}.quest-goals151 p{display:flex;justify-content:space-between}.quest-goals151 b{color:#95ead8}.sys-extra151{display:grid;gap:10px;margin-top:24px}.sys-extra151 h3{grid-column:1/-1}#system-extra151{position:absolute;z-index:19;bottom:23%;right:1.6%;display:flex;gap:5px;max-width:34%;pointer-events:auto}#system-extra151[hidden]{display:none!important}#system-extra151 button{font:clamp(9px,1vw,15px) monospace;background:#0a2037e8;color:#bcf2ff;border:1px solid #66bdef;padding:10px 7px;min-height:42px;border-radius:5px}#system-extra151 button[hidden]{display:none}#system-extra151 button:disabled{opacity:.5}@media(max-height:500px){.status-top151{padding:0}.status-top151>strong{font-size:42px}.equip-layout151{min-height:330px}.equip-slot151{height:77px}.status-stats151{gap:4px;padding:8px}.status-bars151{padding:10px}}
