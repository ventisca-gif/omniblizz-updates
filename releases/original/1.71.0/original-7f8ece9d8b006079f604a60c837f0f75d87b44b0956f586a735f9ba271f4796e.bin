.system-ui148 .skill-list154{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding:4px}.system-ui148 .skill-list154 button,.system-ui148 .sys-extra151 button,.system-ui148 .army-list153 button{background:#0c2942!important;color:#e1f5ff!important;border:1px solid #68b6e5!important;text-shadow:none!important;opacity:1;white-space:normal;min-height:60px;padding:9px!important;font:15px Georgia,serif!important;line-height:1.3!important}.system-ui148 .skill-list154 strong{display:block;font-weight:600;color:#e1f5ff!important}.system-ui148 .skill-list154 small{display:block;color:#9fcee9!important;font:12px monospace!important;margin-top:5px}.system-ui148 .skill-list154 button[aria-pressed=true]{border-color:#6cf0d0!important;background:#10374b!important}.system-ui148 .skill-list154 button:disabled{background:#172331!important;color:#9eb6c7!important;opacity:.75}.army-list153 small{display:block;margin:6px 0;color:#acd3e5}.army-list153 progress{max-width:140px;accent-color:#8ccaff}
