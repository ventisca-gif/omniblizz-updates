.pc179{display:grid;grid-template-columns:28% 72%;gap:0;min-height:350px;color:#263b53;background:repeating-linear-gradient(35deg,#d8c477 0 16px,#e5d38d 16px 31px);border:7px solid #344d65;border-radius:12px;padding:12px;box-sizing:border-box;font-family:monospace}.pc-info179{background:#b5bdca;border:5px ridge #e3e8ec;border-radius:16px;padding:10px;display:flex;flex-direction:column;align-items:center;text-align:center}.pc-info179>canvas{width:100%;height:auto;background-color:#b9d8b2;background-image:linear-gradient(45deg,#a5c99c 25%,transparent 25%,transparent 75%,#a5c99c 75%),linear-gradient(45deg,#a5c99c 25%,transparent 25%,transparent 75%,#a5c99c 75%);background-size:32px 32px;background-position:0 0,16px 16px;border:4px solid white;box-sizing:border-box}.pc-info179 p{font-size:clamp(10px,1.4vw,18px);margin:5px}.pc-main179{padding:0 10px}.pc-main179 nav{display:flex;justify-content:space-between}.pc-main179 nav button{background:#eceff5;color:#263b53;border:3px solid #8a9cb5;border-radius:20px;padding:7px}.pc-main179 h3{text-align:center;background:#f1f5fb;border:4px solid #7197bf;border-radius:24px;margin:8px 0;color:#284667;padding:7px}.pc-grid179{display:grid;grid-template-columns:repeat(6,1fr);grid-template-rows:repeat(5,1fr);gap:1px;background:repeating-radial-gradient(ellipse at 50% -200%,#c0dbea 0 5px,#cce6ef 6px 8px);border:5px solid #7293ad;border-radius:20px;padding:5px}.pc-grid179 button{height:clamp(32px,6.5vh,63px);min-width:0;background:transparent;border:0;border-radius:10px;padding:0;opacity:1}.pc-grid179 button:disabled{opacity:1}.pc-grid179 canvas{height:100%;width:auto;max-width:100%;object-fit:contain}.pc179 .selected{outline:3px solid #ffb338;outline-offset:-3px}.pc-party179{display:flex;background:#e0e7ef;border:3px solid #7395b4;border-radius:14px;margin-top:8px;padding:4px;gap:3px}.pc-party179 button{flex:1;min-width:0;padding:0;border:0;background:#c7d9e6;color:#1b3653;display:flex;flex-direction:column;align-items:center}.pc-party179 canvas{height:48px;width:auto}.pc-party179 small{font-size:10px}#pc-actions179{text-align:center;margin-top:5px}#pc-actions179 button{padding:8px 25px;background:#18496a;color:white;border:3px solid #e9c357;border-radius:8px}#dialog:has(.pc179){max-width:min(1040px,96vw)}.poke-battle179 #poke-hud177,.poke-battle179 #attacks,.poke-battle179 .attack{display:none!important}#pb179{position:absolute;inset:0;z-index:15;pointer-events:none;font-family:monospace}#pb179[hidden]{display:none}.pb-panel179{position:absolute;top:2%;width:27%;padding:8px 14px;border:4px solid #252d37;border-radius:12px;background:#fcfff0;color:#17252b;box-shadow:4px 4px #172e2555;box-sizing:border-box;font-size:clamp(12px,2vw,22px)}.pb-own179{left:2%}.pb-foe179{right:2%}.pb-panel179 b{display:block}.pb-panel179 small{float:right}.pb-panel179 span{display:block;font-size:.65em;text-align:right}.pb-hp179,.pb-energy179{height:9px;background:#28393b;border:2px solid #263a32;border-radius:8px;overflow:hidden;margin-top:3px}.pb-hp179 i,.pb-energy179 i{display:block;height:100%;background:#56d341}.pb-energy179 i{background:#a46bd2}.pb-log179{position:absolute;bottom:0;left:0;right:0;height:8%;box-sizing:border-box;padding:9px 18px;background:#111e19eb;border-top:3px solid #e3d9b1;color:white;font-size:clamp(11px,1.8vw,20px)}.pb-moves179{position:absolute;right:2%;bottom:20%;width:34%;display:grid;grid-template-columns:1fr 1fr;gap:7px;pointer-events:auto}.pb-moves179 button{border:3px solid #7ca0bc;border-radius:12px;background:#102b49ef;color:white;padding:12px 4px;min-height:52px;font-size:clamp(11px,1.6vw,18px)}.pb-moves179 button small{display:block;color:#d6c1ee;margin-top:4px}.pb-moves179 button:disabled{opacity:.52}.pb-tools179{position:absolute;right:2%;bottom:10%;display:flex;gap:6px;pointer-events:auto}.pb-tools179 button{background:#16374be8;color:#fff;border:2px solid #f4cf6c;border-radius:10px;padding:10px;font-size:clamp(10px,1.5vw,17px)}.pb-tools179 button:disabled{opacity:.4}
body.poke177 .dialog[data-pc179]{width:900px;max-width:94%;max-height:510px;padding:12px!important}body.poke177 .dialog[data-pc179] h2{font-size:19px;margin:0 50px 7px 6px}body.poke177 .dialog[data-pc179] #dialogeyebrow{display:none}body.poke177 .dialog[data-pc179] #dialogbuttons{margin:0}body.poke177 .dialog[data-pc179] .pc179 button{min-height:0}body.poke177 .dialog[data-pc179] .pc-grid179 button{height:42px;background:transparent;border:0;border-radius:10px;padding:0;opacity:1}body.poke177 .dialog[data-pc179] .pc-party179 button{background:#c7d9e6;color:#1b3653;padding:0;border:0}body.poke177 .dialog[data-pc179] .pc-main179 nav button{background:#eceff5;color:#263b53;border:3px solid #8a9cb5;border-radius:20px;padding:7px}body.poke177 .dialog[data-pc179] .pc-info179 p{color:#263b53;line-height:1.3;font-size:14px}body.poke177 .dialog[data-pc179] .pc-main179 h3{font-size:18px;margin:5px 0;padding:5px}body.poke177 .dialog[data-pc179] #pc-actions179 button{background:#18496a;color:white;border:3px solid #e9c357;padding:7px 25px}
