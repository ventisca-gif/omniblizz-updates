#hud #system-extra151{position:absolute;right:14px;bottom:205px;width:250px;max-width:none;display:grid;grid-template-columns:repeat(3,1fr);gap:6px;z-index:19;pointer-events:auto}#hud #system-extra151[hidden]{display:none!important}#hud #system-extra151 button{min-width:0;min-height:38px;padding:5px 3px;font-size:10px;line-height:1.25;white-space:normal}#hud #system-extra151 button[hidden]{display:none!important}.army-list153{display:grid;gap:8px;max-height:220px;overflow:auto}.army-list153>div,.army-list153>button{padding:10px;border:1px solid #478ab0;background:#091e32;color:#d1edff}.army-list153 button{margin:4px}
