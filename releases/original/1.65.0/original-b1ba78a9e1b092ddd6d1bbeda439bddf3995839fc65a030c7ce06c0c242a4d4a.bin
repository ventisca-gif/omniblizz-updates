.dialog[data-races156]{width:900px!important;max-width:96%!important;max-height:96%!important;padding:15px 20px!important;border:4px solid #337646!important;border-radius:0!important;background:linear-gradient(125deg,#02180f,#030d0d 65%,#071b13)!important;box-shadow:inset 0 0 0 2px #102c1b,0 0 0 2px #072416!important;clip-path:polygon(17px 0,calc(100% - 17px) 0,100% 17px,100% calc(100% - 17px),calc(100% - 17px) 100%,17px 100%,0 calc(100% - 17px),0 17px)!important;font-family:monospace!important;transform:none!important}.dialog[data-races156] #dialogeyebrow,.dialog[data-races156] #dialogtitle,.dialog[data-races156] #dialogbuttons,.dialog[data-races156] .scroll-controls15{display:none!important}.dialog[data-races156] #dialogbody{padding:0!important;max-height:470px!important;overflow:auto!important;scrollbar-color:#518d54 #06150e}.race-panel156 header{display:flex;align-items:center;gap:12px;margin:0 0 12px;border-bottom:1px solid #28552d;padding-bottom:9px}.race-panel156 header>svg,.race-panel156 header>.portal156{width:54px;height:54px;flex-shrink:0}.race-panel156 h2{font:900 28px/1.1 monospace!important;text-transform:uppercase;letter-spacing:1px;color:#f0f7e6!important;margin:0!important;text-shadow:2px 2px #0c301c}.race-panel156 header p{font:12px/1.4 monospace!important;letter-spacing:1.4px;color:#a8c89c!important;margin:5px 0 0!important}.race-panel156 button{border-radius:0!important;white-space:normal!important;font-family:monospace!important;font-weight:900!important;touch-action:manipulation!important}.race-panel156 header button{margin-left:auto;background:#071d11!important;border:2px solid #3a7850!important;color:#b9ee91!important;font-size:38px!important;line-height:40px;width:43px;height:43px;flex-shrink:0;padding:0!important}.race-cards156{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.race-cards156.multi156{grid-template-columns:repeat(2,minmax(0,1fr))}.race-card156{--race:#8de937;--dark:#163d0c;background:linear-gradient(135deg,#071710,#030c0a);border:3px solid var(--race);padding:7px 10px 12px;min-width:0;box-shadow:inset 0 0 0 3px #000a;clip-path:polygon(10px 0,calc(100% - 10px) 0,100% 10px,100% calc(100% - 10px),calc(100% - 10px) 100%,10px 100%,0 calc(100% - 10px),0 10px)}.race-card156.race-osmo,.race-card156.race-bendy{--race:#e8ae4e;--dark:#54350e}.race-card156.race-anodite,.race-card156.race-system148{--race:#a46be7;--dark:#2c1554}.race-card156.selected156{border-color:#b5ff7c;box-shadow:inset 0 0 0 2px #448d24,0 0 10px #84eb4d70}.race-card156 canvas{display:block!important;width:100%!important;height:158px!important;object-fit:cover;image-rendering:pixelated;border:0!important;background:#030b0a;mask-image:linear-gradient(#000 83%,transparent)}.multi156 .race-card156 canvas{height:166px!important;object-fit:cover;object-position:center 30%}.race-panel156 .race-card156 h3{font:900 20px/1.15 monospace!important;text-align:center;color:#f4f5e9!important;margin:3px 0 7px!important;letter-spacing:-.5px}.race-panel156 .race-desc156{text-align:center;margin:0 0 6px!important;font:13px monospace!important;color:var(--race)!important}.race-panel156 .race-level156{font:14px monospace!important;text-align:center;color:#c5d8cf!important;margin:5px 0 8px!important}.race-progress156{height:12px;padding:2px;border:1px solid #68877c;border-radius:3px;background:#11211e;margin-bottom:13px}.race-progress156 i{display:block;height:100%;min-width:3px;background:var(--race);box-shadow:0 0 5px var(--race)}.race-card156>button{display:block;width:100%;min-height:40px;padding:7px!important;color:var(--race)!important;background:linear-gradient(var(--dark),#10150f)!important;border:2px solid var(--race)!important;font-size:17px!important;clip-path:polygon(8px 0,calc(100% - 8px) 0,100% 8px,100% calc(100% - 8px),calc(100% - 8px) 100%,8px 100%,0 calc(100% - 8px),0 8px)}.selected156>button{color:#d6ffa3!important;background:linear-gradient(#285d13,#143108)!important}.race-panel156 footer{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:14px}.race-panel156 footer button{display:flex;align-items:center;justify-content:center;gap:8px;min-height:48px;min-width:215px;background:#071d2c!important;color:#abddf5!important;border:2px solid #4f8eb8!important;padding:5px 10px!important;font-size:14px!important;clip-path:polygon(8px 0,calc(100% - 8px) 0,100% 8px,100% calc(100% - 8px),calc(100% - 8px) 100%,8px 100%,0 calc(100% - 8px),0 8px)}.race-panel156 footer svg{width:35px;height:35px}.race-panel156 footer p{flex:1;font:11px/1.4 monospace!important;color:#94b0a1!important;text-align:center;margin:0!important}.race-panel156 footer button.race-done156{background:linear-gradient(110deg,#b5ed5b,#72c52c)!important;color:#0a2106!important;border-color:#b7ee70!important;font-size:25px!important;min-width:200px}.portal156{display:grid;place-items:center;color:#d7faff;font:54px/1 monospace;filter:drop-shadow(0 0 5px #4678ff)}.race-panel156 footer .portal156{font-size:35px;width:35px}
.dialog[data-races156] #scrollnav{display:none!important}

.race-card156>button.subraces157{min-height:30px;margin:0 0 5px!important;padding:3px!important;font-size:14px!important;color:#c8ee8b!important;background:linear-gradient(#24470a,#10230a)!important}.race-card156.race-omni:has(.subraces157)>canvas{height:123px!important}.sub-card157.sub-0{--race:#ff333f;--dark:#450b13}.sub-card157.sub-1{--race:#38d5ff;--dark:#06334a}.sub-card157.sub-2{--race:#ff3eb9;--dark:#430d38}.race-panel156 .sub-card157 canvas{height:205px!important;mask-image:linear-gradient(#000 88%,transparent)}.race-panel156 .sub-card157 h3{font-size:23px!important;margin:9px 0 12px!important}.sub-card157>button:disabled{color:#9daab6!important;background:linear-gradient(#1d2930,#13191e)!important;border-color:#72828e!important;opacity:1!important;cursor:default}.sub-panel157 header p{color:#8bd986!important;font-size:17px!important}

.race-panel156 .sub-lock157{display:inline-block;width:18px;height:22px;vertical-align:middle;margin-right:7px}
