#game #hud.hud86[data-skin162] #attacks .attack{width:auto!important;height:auto!important;min-width:0!important;padding:5px 2px!important;position:relative!important;}
#game #hud.hud86[data-skin162] #attacks .attack b{font-size:0!important;line-height:1!important;display:block!important;color:var(--a162)!important;}
