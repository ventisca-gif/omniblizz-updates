#game #hud.hud86[data-skin162] #mission{left:594px!important;right:auto!important;width:315px!important;padding:12px 22px 10px 48px!important;text-align:left!important}
#game #hud.hud86[data-skin162] #mission:before{left:10px!important;top:12px!important;width:26px!important;height:26px!important;line-height:25px!important;border:1px solid var(--a162)!important;border-radius:3px!important;color:var(--l162)!important;transform:rotate(0deg)!important;background:radial-gradient(circle,var(--g162),transparent)!important}
#game #hud.hud86[data-skin162] #mission:after{content:"›"!important;right:10px!important;top:35px!important;font-size:27px!important;color:var(--a162)!important}
