#game #hud.hud86[data-skin162] #regen,#game #hud.hud86[data-skin162] #lawstatus{left:20px!important;top:124px!important;width:145px!important;max-width:none!important;height:39px!important;padding:3px 5px!important;font-size:8px!important;line-height:12px!important}
