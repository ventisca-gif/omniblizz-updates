#game #hud.hud86[data-skin162] #transform{left:260px!important;bottom:20px!important;top:auto!important;width:190px!important;height:100px!important;padding:8px!important;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;}
#game #hud.hud86[data-skin162] #transform:before{content:""!important;display:block!important;width:40px!important;height:40px!important;margin:0 auto!important;background:var(--a162)!important;mask:url("hud162/star.svg") center/contain no-repeat;-webkit-mask:url("hud162/star.svg") center/contain no-repeat;}
