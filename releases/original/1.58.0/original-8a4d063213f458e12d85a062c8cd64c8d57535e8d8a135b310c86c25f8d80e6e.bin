/* Four race-specific live HUDs, 960x540 logical coordinates. No baked-in text or stats. */
#game #hud.hud86[data-skin162]{--a162:#48bdff;--l162:#c4f3ff;--d162:#030e20;--g162:#269eff55;--frame162:url("hud162/system-frame.svg");--joy162:url("hud162/system-joystick.svg");font-family:Arial,Helvetica,sans-serif}
#game #hud.hud86[data-skin162="system"]{--a162:#48bdff;--l162:#9aefff;--d162:#020c20;--g162:#48bdff44;--frame162:url("hud162/system-frame.svg");--joy162:url("hud162/system-joystick.svg")}
#game #hud.hud86[data-skin162="anodite"]{--a162:#e77bce;--l162:#ffc0f2;--d162:#1b081d;--g162:#e77bce44;--frame162:url("hud162/anodite-frame.svg");--joy162:url("hud162/anodite-joystick.svg")}
