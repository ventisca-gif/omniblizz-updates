#game #hud.hud86[data-skin162] .vitals,#game #hud.hud86[data-skin162] .omni,#game #hud.hud86[data-skin162] #mission,#game #hud.hud86[data-skin162] #treebtn,#game #hud.hud86[data-skin162] #coins,#game #hud.hud86[data-skin162] #regen,#game #hud.hud86[data-skin162] #lawstatus,#game #hud.hud86[data-skin162] #clock,#game #hud.hud86[data-skin162] #jump,#game #hud.hud86[data-skin162] #greypunch,#game #hud.hud86[data-skin162] #ultrabasic,#game #hud.hud86[data-skin162] #moreattacks,#game #hud.hud86[data-skin162] .attack,#game #hud.hud86[data-skin162] #transform,#game #hud.hud86[data-skin162] #extra28,#game #hud.hud86[data-skin162] #gwen51toggle,#game #hud.hud86[data-skin162] #phone-button105,#game #hud.hud86[data-skin162] #system-extra151 button,#game #hud.hud86[data-skin162] #pause{border:9px solid transparent!important;border-image:var(--frame162) 28 fill stretch!important;border-radius:0!important;background:transparent!important;box-shadow:0 0 5px var(--g162)!important;color:var(--l162)!important;text-shadow:0 1px 2px #000;}
