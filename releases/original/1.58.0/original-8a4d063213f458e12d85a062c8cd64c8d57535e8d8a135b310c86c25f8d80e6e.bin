#game #hud.hud86[data-skin162] #xptext{font-size:9px!important;line-height:12px!important;margin-top:3px!important;color:var(--l162)!important}
#game #hud.hud86[data-skin162] .omni{left:355px!important;width:220px!important;padding:12px 15px!important;}
