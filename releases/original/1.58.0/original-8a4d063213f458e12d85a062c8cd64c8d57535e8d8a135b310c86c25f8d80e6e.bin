#game #hud.hud86[data-skin162="bendy"] .attack[data-skill="0"]{--icon162:url("hud162/splat.svg")}
#game #hud.hud86[data-skin162="bendy"] .attack[data-skill="1"]{--icon162:url("hud162/puddle.svg")}
#game #hud.hud86[data-skin162="bendy"] .attack[data-skill="2"]{--icon162:url("hud162/charge.svg")}
#game #hud.hud86[data-skin162="bendy"] .attack[data-skill="3"]{--icon162:url("hud162/swirl.svg")}
#game #hud.hud86[data-skin162="osmo"] .attack[data-skill="0"]{--icon162:url("hud162/fist.svg")}
#game #hud.hud86[data-skin162="osmo"] .attack[data-skill="1"]{--icon162:url("hud162/crystal.svg")}
#game #hud.hud86[data-skin162="osmo"] .attack[data-skill="2"]{--icon162:url("hud162/spikes.svg")}
#game #hud.hud86[data-skin162="osmo"] .attack[data-skill="3"]{--icon162:url("hud162/bolt.svg")}
#game #hud.hud86[data-skin162="system"] .attack[data-skill="0"]{--icon162:url("hud162/dagger.svg")}
#game #hud.hud86[data-skin162="system"] .attack[data-skill="1"]{--icon162:url("hud162/blades.svg")}
#game #hud.hud86[data-skin162="system"] .attack[data-skill="2"]{--icon162:url("hud162/run.svg")}
#game #hud.hud86[data-skin162="system"] .attack[data-skill="3"]{--icon162:url("hud162/shield.svg")}
#game #hud.hud86[data-skin162] .hidden,#game #hud.hud86[data-skin162] [hidden],#game #hud.hud86[data-skin162] #system-extra151[hidden],#game #hud.hud86[data-skin162] #system-extra151 button[hidden]{display:none!important}
#game #hud.hud86[data-skin162][data-base86="true"] #attacks{height:106px!important;width:145px!important;grid-template-columns:1fr!important}
#game #hud.hud86[data-skin162][data-base86="true"] #attacks .attack[data-skill="0"]{grid-column:auto!important}
#game #hud.hud86[data-skin162][data-base86="true"] .attack[data-skill="0"]{--icon162:url("hud162/fist.svg")}
@media(prefers-reduced-motion:reduce){#game #hud.hud86[data-skin162] *{animation:none!important;transition:none!important}}

#game #hud.hud86[data-skin162]{isolation:isolate}
#game #hud.hud86[data-skin162] #mission strong,#game #hud.hud86[data-skin162] #mission .tiny{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
#game #hud.hud86[data-skin162="anodite"] .identity,#game #hud.hud86[data-skin162="anodite"] .attack span,#game #hud.hud86[data-skin162="anodite"] #transform strong,#game #hud.hud86[data-skin162="bendy"] .identity,#game #hud.hud86[data-skin162="bendy"] .attack span,#game #hud.hud86[data-skin162="bendy"] #transform strong{font-family:Georgia,serif!important}
#game #hud.hud86[data-skin162="anodite"] .omni{padding-left:58px!important}#game #hud.hud86[data-skin162="anodite"] .omni:before{content:"";position:absolute;left:9px;top:22px;width:34px;height:43px;background:var(--a162);mask:url("hud162/flame.svg") center/contain no-repeat;-webkit-mask:url("hud162/flame.svg") center/contain no-repeat;filter:drop-shadow(0 0 7px #ff60d6)}
#game #hud.hud86[data-skin162="bendy"] .omni{padding-left:41px!important}#game #hud.hud86[data-skin162="bendy"] .omni:before{content:"";position:absolute;left:8px;top:12px;width:24px;height:30px;background:var(--a162);mask:url("hud162/drop.svg") center/contain no-repeat;-webkit-mask:url("hud162/drop.svg") center/contain no-repeat}
#game #hud.hud86[data-skin162="osmo"] .omni{padding-left:35px!important}#game #hud.hud86[data-skin162="osmo"] .omni:before{content:"";position:absolute;left:-27px;top:-4px;width:48px;height:89px;background:linear-gradient(100deg,#1d7794,#8df8ff,#26aeca);clip-path:polygon(48% 0,65% 22%,70% 6%,92% 36%,76% 85%,55% 100%,20% 83%,0 36%,20% 18%,29% 55%);border:1px solid #b1f8ff;filter:drop-shadow(0 0 3px #66eaff)}
#game #hud.hud86[data-skin162="system"] #system-extra151 [data-action153="hand"]{--action-icon162:url("hud162/hand.svg")}
#game #hud.hud86[data-skin162="system"] #system-extra151 [data-action153="exchange"]{--action-icon162:url("hud162/swap.svg")}
#game #hud.hud86[data-skin162="system"] #system-extra151 [data-action153="orders"]{--action-icon162:url("hud162/army.svg")}

#game #hud.hud86[data-skin162] .vitals{padding:9px 16px 5px 99px!important}
#game #hud.hud86[data-skin162] .vitals .hp{margin-top:6px!important}
#game #hud.hud86[data-skin162] .vitals .xp{margin-top:6px!important}
#game #hud.hud86[data-skin162] #xptext{font-size:8.5px!important;line-height:10px!important;margin-top:2px!important}
#game #hud.hud86[data-skin162] .omni{padding-top:6px!important;padding-bottom:4px!important}
#game #hud.hud86[data-skin162] .omni .battery{height:11px!important;margin-top:5px!important}
#game #hud.hud86[data-skin162] .omni #batteryhint{font-size:8px!important;line-height:10px!important;margin-top:2px!important}
#game #hud.hud86[data-skin162] .mastery{font-size:8px!important;line-height:10px!important;margin-top:2px!important}
#game #hud.hud86[data-skin162] .masterybar{height:3px!important;margin-top:2px!important}
#game #hud.hud86[data-skin162] #mission{padding-top:9px!important;padding-bottom:7px!important}
#game #hud.hud86[data-skin162] #transform{padding:4px!important;gap:3px!important}
#game #hud.hud86[data-skin162] #transform:before{width:34px!important;height:34px!important;flex-shrink:0}
#game #hud.hud86[data-skin162] #transform strong{font-size:14px!important;line-height:16px!important}
#game #hud.hud86[data-skin162] #transform small{font-size:8px!important;line-height:10px!important}
#game #hud.hud86[data-skin162="system"] #transform:before{width:42px!important;height:42px!important}
#game #hud.hud86[data-skin162="osmo"] #transform:before{width:57px!important;height:57px!important}
#game #hud.hud86[data-skin162="system"] #system-extra151 button{border-width:7px!important;padding:2px 1px!important;font-size:8px!important;line-height:10px!important}
#game #hud.hud86[data-skin162="system"] #system-extra151 button:before{width:24px!important;height:24px!important;margin-bottom:2px!important}

#system-frame162,#system-label162{display:none}
#game #hud.hud86[data-skin162] .attack b:before,#game #hud.hud86[data-skin162] #system-extra151 button:before{mask-mode:luminance}

#game #hud.hud86[data-skin162="system"] .attack[data-skill="4"]{--icon162:url("hud162/dagger.svg")}
#game #hud.hud86[data-skin162="system"] .attack[data-skill="5"]{--icon162:url("hud162/heal.svg")}
#game #hud.hud86[data-skin162="system"] .omni .identity{justify-content:center!important}
#game #hud.hud86[data-skin162="system"] .omni #energyname{display:none!important}
#game #hud.hud86[data-skin162="system"] .omni #batterytext{font-size:11px!important;color:var(--l162)!important}
#game #hud.hud86[data-skin162="anodite"] #xpfill,#game #hud.hud86[data-skin162="anodite"] #masteryfill{background:linear-gradient(90deg,#31b7e7,#a3e6ff)!important}
