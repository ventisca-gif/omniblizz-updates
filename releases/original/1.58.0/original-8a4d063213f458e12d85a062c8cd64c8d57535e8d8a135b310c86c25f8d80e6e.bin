#game #hud.hud86[data-skin162] .vitals:after,#game #hud.hud86[data-skin162] .omni:after{content:none!important}
#game #hud.hud86[data-skin162] #portrait86{left:8px!important;top:3px!important;width:80px!important;height:80px!important;border:2px solid var(--a162)!important;box-shadow:0 0 0 4px var(--d162),0 0 0 5px var(--a162),0 0 11px var(--g162)!important;background:radial-gradient(circle,#1a354a,var(--d162) 72%)!important;border-radius:50%!important}
#game #hud.hud86[data-skin162] .identity{font-size:11px!important;letter-spacing:.2px!important;line-height:14px!important;white-space:nowrap!important}
#game #hud.hud86[data-skin162] .identity b{font-size:10px!important;color:var(--a162)!important}
#game #hud.hud86[data-skin162] .vitals .hp{height:17px!important;margin-top:9px!important;border:1px solid var(--a162)!important;border-radius:3px!important;background:#01070c!important}
