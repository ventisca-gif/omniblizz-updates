#game #hud.hud86[data-skin162] #joystick:before,#game #hud.hud86[data-skin162] #joystick:after{content:none!important}
#game #hud.hud86[data-skin162] #joystick .joystick-ring{inset:33px!important;border:1px solid var(--a162)!important;border-radius:50%!important;opacity:.3!important}
#game #hud.hud86[data-skin162] #joystick>span{color:var(--a162)!important;text-shadow:0 0 6px var(--g162);font-size:15px!important}
