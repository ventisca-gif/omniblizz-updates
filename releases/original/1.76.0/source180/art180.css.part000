body.sai167 #sai-vitals167{padding-left:96px;min-height:128px;background:linear-gradient(135deg,#102f4cf2,#05162ced);border:3px solid #ffc34c;border-radius:14px;box-shadow:inset 0 0 0 2px #42617a,0 2px 8px #0006}#sai-avatar180{position:absolute;left:9px;top:10px;width:77px;height:96px;background:linear-gradient(#6bcaee,#376fa4);border:2px solid #ffc55b;border-radius:8px;object-fit:cover}body.sai167 #sai-hud167 #sai-kai172[aria-pressed=true]{border-color:#ff7272;background:linear-gradient(#561a34,#130e27);box-shadow:0 0 16px #ff244b,inset 0 0 9px #ff416055}body.sai167 #sai-hud167 #sai-kai172[aria-pressed=true]::before{color:#ff3b57;text-shadow:0 0 10px #ff143c}body.sai167 #sai-hud167 #sai-fly172[aria-pressed=true]{border-color:#7feaff;box-shadow:0 0 13px #36b6ff}body.sai167 #sai-place167{font-weight:900;text-shadow:0 2px 2px #06182c,2px 0 2px #06182c}@media(max-width:650px){body.sai167 #sai-vitals167{padding-left:70px;min-height:100px}#sai-avatar180{width:53px;height:77px;left:7px;top:8px}}
